# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=fantasy_app

# Auth
# Generate a strong secret with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (CORS).
# e.g. ALLOWED_ORIGINS=https://yourapp.com,https://admin.yourapp.com
ALLOWED_ORIGINS=http://localhost:3000
